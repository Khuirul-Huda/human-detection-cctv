# Configuration template for Lightweight Multi-Stream Human Detection
# Copy this file to .env and adjust with your own camera and bot credentials.
# Do NOT commit your real .env file.

# Camera 1 (Sub-stream recommended for low CPU usage)
CAM1_ENABLE=true
CAM1_NAME=kamera1
CAM1_URL=rtsp://username:password@192.168.1.100:554/streamtype=1
CAM1_TRANSPORT=tcp

# Camera 2
CAM2_ENABLE=true
CAM2_NAME=kamera2
CAM2_URL=rtsp://username:password@192.168.1.106:554/onvif2
CAM2_TRANSPORT=udp

# Processing Parameters (Ultra-lightweight)
STREAM_FPS=1
STREAM_WIDTH=320
STREAM_HEIGHT=320
FF_THREADS=1

# AI Model settings
MODEL_PATH=models/yolov8n.onnx
PROB_THRESHOLD=0.5
AI_MIN_INTERVAL=3.0

# Motion Gating Sensitivity
MOTION_THRESHOLD=400
MOTION_DELTA_THRESHOLD=18
MOTION_BLUR_SIZE=15
MOTION_DILATE_ITERATIONS=1
MOTION_ALPHA=0.3
MOTION_WARMUP_FRAMES=8

# Telegram Alert Settings
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
ALERT_COOLDOWN_SECONDS=60

# Audio Chime Alert Settings
ENABLE_AUDIO_ALERT=true
AUDIO_ALERT_FILE=assets/ding.wav
AUDIO_COOLDOWN_SECONDS=15
