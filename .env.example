# .env for human-detection-cctv — populated from .env.example
# Edit secrets (TELEGRAM_TOKEN) and chat IDs before running. Do NOT commit this file.

STREAM_URL=srt://127.0.0.1:8890?streamid=read:kamera1
MODEL_PATH=models/yolov8n.onnx
STREAM_WIDTH=640
STREAM_HEIGHT=640
STREAM_FPS=8
FF_THREADS=1
JPEG_QUALITY=8
AI_INTERVAL=5
USE_HWACCEL=true

# Insert your real Telegram bot token and chat IDs below
# Get token from @BotFather and chat id via getUpdates or @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=19500xxxx
# To notify multiple recipients, comma-separate IDs:
# TELEGRAM_CHAT_IDS=1950055011,123456789

# Motion sensitivity settings
# MOTION_THRESHOLD: total changed pixels needed before AI is triggered. Lower = more sensitive. Previous default: 500, current: 250.
# MOTION_DELTA_THRESHOLD: per-pixel brightness change needed to count as motion. Lower = more sensitive. Previous default: 25, current: 18.
# MOTION_BLUR_SIZE: blur kernel size before comparing frames. Smaller = more sensitive, but noisier. Previous default: 21, current: 15.
# MOTION_DILATE_ITERATIONS: how much to expand detected motion areas. Higher = more tolerant to small gaps. Previous default: 2, current: 1.
# MOTION_ALPHA: background update speed for the moving average. Higher = adapts faster to scene changes. Previous default: 0.5, current: 0.3.
MOTION_THRESHOLD=250
MOTION_DELTA_THRESHOLD=18
MOTION_BLUR_SIZE=15
MOTION_DILATE_ITERATIONS=1
MOTION_ALPHA=0.3
PROB_THRESHOLD=0.5
